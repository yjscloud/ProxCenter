{
  "name": "proxcenter-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:graph": "node scripts/check-graph.mjs",
    "verify": "npm run typecheck && npm run check:graph && npm run build",
    "serve:dist": "node scripts/serve-dist.mjs",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "@novnc/novnc": "^1.5.0",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "esbuild": "^0.21.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
