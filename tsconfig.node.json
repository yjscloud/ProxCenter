{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    /* 与 tsconfig.json 同一原因：依赖目录是软链，必须保留路径名才能解析到
       包内部的互相引用（详见 tsconfig.json 里的说明）。 */
    "preserveSymlinks": true,
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
