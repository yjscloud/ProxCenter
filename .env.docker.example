# ============================================================================
#  可选的变量覆盖文件 —— **不下载它也能部署**
#
#  docker-compose.yml 里已经给数据库口令与面板登录口令填好了默认值，
#  直接 `docker compose up -d` 即可启动，本文件不是必须的。
#
#  只有当你想把口令换成自己的时候才需要：
#      cp .env.docker.example .env     # 然后取消下面注释、填上自己的值
#
#  compose 会自动读取同目录的 .env，其优先级**高于** docker-compose.yml 里的默认值。
#
#  ⚠️ 注意：口令只在「第一次」生效 ——
#    * ADMIN_PASSWORD 只在库里还没有管理员时用来建号；
#    * 数据库口令只在 MySQL 的数据目录为空时初始化。
#    已经跑起来之后再改这里，需要 `docker compose down -v` 重建（会清空数据）
#    或进库手动改，否则面板会连不上库。
# ============================================================================

# --- 面板登录 ---------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=换成你自己的口令（至少 12 位，且不是弱口令）

# --- 数据库（compose 用它初始化 MySQL，并注入面板）--------------------------
# MYSQL_ROOT_PASSWORD=换成你自己的 MySQL root 口令
# DB_NAME=proxcenter_panel
# DB_USER=proxcenter
# DB_PASSWORD=换成你自己的库口令

# --- 密钥 -------------------------------------------------------------------
# 留空即可：容器首次启动会随机生成并保存到 panel_data 卷。
# 已有数据后**绝不要**再改，否则库里已加密的密文（PVE Token / SMTP 口令）会全部解不开。
# SECRET_KEY=

# --- 其他 -------------------------------------------------------------------
# PANEL_PORT=8080
# PROXCENTER_IMAGE=ghcr.io/yjscloud/proxcenter:latest
# FORCE_HTTPS=false
# FORWARDED_ALLOW_IPS=*
# TZ=Asia/Shanghai

# Proxmox 连接初始值（登录后也能在「设置」页在线修改，可留空）
# PVE_HOST=
# PVE_PORT=8006
# PVE_TOKEN_ID=
# PVE_TOKEN_SECRET=
# PVE_VERIFY_SSL=true
