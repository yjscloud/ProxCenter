# ============================================================================
#  ProxCenter — 口令自定义模板（可选，不用它也能部署）
#
#  用法三步：
#      1) cp .env.docker.example .env
#      2) 把下面标了「★ 改这里」的口令换成你自己的
#      3) docker compose up -d
#
#  本文件里的值会**覆盖** docker-compose.yml 里的默认值；只填想改的项即可，
#  没填的仍然用 docker-compose.yml 里的默认值。
#
#  ⚠ 这里的写法和 docker-compose.yml 不一样，别混淆：
#
#      · .env（本文件）—— 等号后面**直接写口令本身**：
#            ADMIN_PASSWORD=MyPassw0rd2026
#
#      · docker-compose.yml —— 口令写在 `${变量名:-默认值}` 的**默认值**位置：
#            ADMIN_PASSWORD: ${ADMIN_PASSWORD:-MyPassw0rd2026}
#        那里的 `:-`、`$`、`{`、`}` 都只是语法符号，不是口令的一部分。
#
#  ⚠ 注释请单独占一行：值后面**不要**再跟 `# 注释`，否则那串注释有可能被
#     当成口令的一部分（不同 compose 版本对行尾注释的处理并不一致）。
# ============================================================================


# ---------------------------------------------------------------------------
# ★ 改这里（三项口令）
# ---------------------------------------------------------------------------

# 面板登录口令（账号见下面的 ADMIN_USERNAME）。
# 写成：等号后面直接是你想用的口令本身，例如 ——
#     ADMIN_PASSWORD=MyPassw0rd2026
# 要求至少 12 位，且不能是 admin123 / password 这类弱口令，否则后端拒绝启动。
# 只在数据库里还没有管理员时生效 —— 已经部署并登录过的实例再改这里不会改变
# 现有口令，请登录后在「个人中心 → 修改密码」里改。
ADMIN_PASSWORD=ProxCenter@2026

# 面板连接数据库用的口令（同样是等号后面直接写口令本身）
DB_PASSWORD=ProxCenter-Db-2026

# MySQL 管理员（root）口令，仅用于数据库首次初始化
MYSQL_ROOT_PASSWORD=ProxCenter-Root-2026


# ---------------------------------------------------------------------------
# ★ 密钥：保持留空即可
#   容器首次启动会随机生成并保存到 panel_data 卷。
#   它既是登录 JWT 的签名密钥，也是库里密文（PVE Token / SMTP 口令）的加密根 ——
#   已有数据后改掉它，那些密文就全部解不开了。
#   确实要自己指定，就在这里填一个 ≥ 32 位的随机串。
# ---------------------------------------------------------------------------
SECRET_KEY=


# ---------------------------------------------------------------------------
# 以下一般不用改
# ---------------------------------------------------------------------------

# 面板登录用户名
ADMIN_USERNAME=admin

# 数据库名与账号（改了 DB_* 后 docker-compose.yml 里两边会同步）
DB_NAME=proxcenter_panel
DB_USER=proxcenter

# 面板对宿主机暴露的端口（8080 被占用时改，例如 18080）
PANEL_PORT=8080

# 镜像来源。默认 GHCR；也可换 Docker Hub 或固定版本号：
# PROXCENTER_IMAGE=docker.io/yjscloud/proxcenter:latest
PROXCENTER_IMAGE=ghcr.io/yjscloud/proxcenter:latest

# 由反向代理终结 TLS 时置 true
FORCE_HTTPS=false

# 反向代理不在面板容器内的 127.0.0.1 时，填反代的**实际来源地址**；
# 只有当反代本身可控的内网环境下才用 *
FORWARDED_ALLOW_IPS=*

TZ=Asia/Shanghai

# Proxmox 连接初始值（登录后也能在「设置」页在线修改，可留空）
PVE_HOST=
PVE_PORT=8006
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
PVE_VERIFY_SSL=true
