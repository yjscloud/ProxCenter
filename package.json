{
  "name": "proxcenter-panel",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:graph": "node scripts/check-graph.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:quota": "node scripts/check-quota-invalidation.mjs",
    "verify": "npm run typecheck && npm run check:graph && npm run check:i18n && npm run check:quota && npm run build",
    "serve:dist": "node scripts/serve-dist.mjs",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "@novnc/novnc": "^1.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.7.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
