# ============================================================================
#  ProxCenter — 后端配置示例
#  复制为 .env 后按需修改：  cp .env.example .env
#  注意：.env 中的值只是「初始默认值」。面板启动后可在「设置」页面在线修改
#        连接配置，在线配置存放在 MySQL 中，优先级高于本文件。
# ============================================================================

# --- 面板服务监听 -----------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# --- 安全 -------------------------------------------------------------------
# 【必填，留占位值会直接拒绝启动】用于签发登录 JWT，同时也是库里密文
# （crypto.py：PVE token secret、SMTP/飞书等）的加密根。
# 生成一个随机值：  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 首次启动时自动创建的管理员账号。口令留空或 admin123 之类弱默认值会被
# 拒绝建号（拒绝启动）——务必先改成自己的强口令，登录后再改一次也可以。
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- HTTPS ------------------------------------------------------------------
# 面板自身不提供 TLS，TLS 由前面的 Nginx/Caddy 终结。开启后明文 HTTP 一律
# 308 到 https://<Host>（本机回环的健康检查除外），HTTPS 响应带 HSTS。
# 挂反代时务必让反代带上 X-Forwarded-Proto（见下面 FORWARDED_ALLOW_IPS）。
FORCE_HTTPS=false
# uvicorn 信任哪些来源传来的 X-Forwarded-Proto。默认只信本机反代；改成
# 0.0.0.0 等于让公网请求自称「我是 https」，从而绕过 FORCE_HTTPS。
# 同时决定「信任谁的 X-Forwarded-For」—— 限流按来源 IP 计数，只信反代的头。
FORWARDED_ALLOW_IPS=127.0.0.1

# --- 登录防爆破 / 会话 / 两步验证 / 限流 ------------------------------------
# 图形验证码可以被关掉，光靠它挡不住脚本：这里按账号 + 来源 IP 双计数，
# 连续失败 N 次锁定一段时间，计数落 MySQL（重启不清零）。
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# access token 有效期（分钟）与 refresh token 有效期（天）。
# refresh token 放在 HttpOnly Cookie 里，前端在 401 时自动换新，所以 access
# 可以调短（例如 60）而不影响体验；改短后「踢下线」的生效也更快。
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14
# refresh cookie 是否只走 HTTPS（留空 = 跟随 FORCE_HTTPS）。
# COOKIE_SECURE=

# 强制开启两步验证的角色（逗号分隔）。填 admin = 管理员必须先绑定 TOTP 才能
# 使用面板；留空则全员可选（人人都能在「个人中心」自行开启）。
TOTP_REQUIRED_ROLES=
# 认证器 App 里显示的名称，建议写成面板的公网域名
TOTP_ISSUER=Proxmox Panel

# 全局限流（按来源 IP，计数同样落 MySQL）。只作用于 /api/*，静态资源不受影响。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
# 登录 / 注册 / 找回密码 / 刷新令牌 / 2FA 单独一条更紧的线
RATE_LIMIT_AUTH_PER_MINUTE=30

# 敏感操作二次确认：删虚拟机、改连接凭据、增删账号、改邮件口令这类危险动作，
# 要求先用密码（开了两步验证再加动态码）重新确认身份。窗口内的重复操作
# 不必反复输入；窗口越长越方便，越短越安全。
STEP_UP_REQUIRED=true
STEP_UP_WINDOW_MINUTES=5

# --- Proxmox 连接（也可登录后在「设置」页面配置）-----------------------------
# 只填 IP 或域名，不要带 https:// 前缀
PVE_HOST=
PVE_PORT=8006
# 形如 panel@pve!panel
PVE_TOKEN_ID=
# Token 的 UUID，形如 1a2b3c4d-5e6f-7890-abcd-ef1234567890
PVE_TOKEN_SECRET=
# 出站访问 Proxmox 是否校验证书，**默认开启**。
# Proxmox 默认安装用的是自签证书（浏览器信任不了，httpx 也不行）：
# 这种情况改为 false，或在「设置」页面里对该连接关闭并填 PVE 自签 CA。
PVE_VERIFY_SSL=true
PVE_DEFAULT_NODE=

# 是否允许连接请求走环境变量里的 HTTP_PROXY / HTTPS_PROXY。
# 默认 false：Proxmox 一般在内网，若运行环境（容器、CI、企业网络）恰好设置了
# 代理变量，请求会被代理截走并返回难以理解的 502。
# 只有确实必须经代理访问集群时才改为 true，或把 Proxmox 地址加入 NO_PROXY。
PVE_TRUST_ENV=false

# --- 控制台（VNC / 串口）----------------------------------------------------
# Proxmox 不允许 API Token 访问 vncproxy / termproxy，这两类接口只接受
# 用户名密码换取的 ticket。若要使用浏览器内控制台，必须另外提供一个 PVE 账号。
# 建议用权限最小的专用账号（仅授予 PVEVMUser）。留空则控制台功能不可用，
# 其余功能不受影响。
PVE_CONSOLE_USER=
PVE_CONSOLE_PASSWORD=

# --- 其他 -------------------------------------------------------------------
# 允许的前端来源，逗号分隔（仅开发时跨域需要；生产同源部署可留空）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Proxmox API 请求超时（秒）
HTTP_TIMEOUT=30
# 任务状态轮询间隔（秒）
TASK_POLL_INTERVAL=2

# --- 监控历史落库 ------------------------------------------------------------
# 节点与虚拟机的 CPU / 内存 / 磁盘 / 网络指标按周期采样进 MySQL 的
# metrics_history 表，供「查任意历史区间 / 出周月报 / 容量预测」使用。
# PVE 自带的 rrddata 是主机侧滚动覆盖的，面板重启或主机重装都会丢。
METRICS_HISTORY_ENABLED=true
# 采样周期（秒）。60 秒 ≈ 每对象每天 1440 行。
METRICS_SAMPLE_INTERVAL=60
# 保留天数，每小时清理一次超期数据；填 0 或负数表示永久保留（表会一直涨）。
METRICS_RETENTION_DAYS=30

# --- 数据库（只支持 MySQL）---------------------------------------------------
# 先在 MySQL 里建好库与账号，表结构由面板启动时自动创建：
#   CREATE DATABASE zhangbeihai_panel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# 连接池上限
DB_POOL_SIZE=8
