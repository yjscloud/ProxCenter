# ============================================================================
#  ProxCenter — 后端配置示例
#  复制为 .env 后按需修改：  cp .env.example .env
#  注意：.env 中的值只是「初始默认值」。面板启动后可在「设置」页面在线修改
#        连接配置，在线配置存放在 MySQL 中，优先级高于本文件。
# ============================================================================

# --- 面板服务监听 -----------------------------------------------------------
# 默认监听所有网卡：装完直接用 http://<服务器 IP>:8080 打开。全新安装最常见的
# 第一反应就是拿浏览器试这个地址，绑回环会让人以为面板没装好（只能在本机 curl）。
# 前面有反向代理（nginx / caddy）时建议改回 127.0.0.1：8080 只由反代访问，少一份
# 可绕过反代限速与审计的表面；改完 systemctl restart proxcenter。
# 对外开放时请配合防火墙，并用「面板准入白名单」（PANEL_ALLOW_CIDRS）收敛来源。
# Docker 部署由编排里的容器网络决定，这里不影响。
HOST=0.0.0.0
PORT=8080

# --- 安全 -------------------------------------------------------------------
# 【必填，留占位值会直接拒绝启动】用于签发登录 JWT，同时也是库里密文
# （crypto.py：PVE token secret、SMTP/飞书等）的加密根。
# 生成一个随机值：  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 首次启动时自动创建的管理员账号。口令留空或 admin123 之类弱默认值会被
# 拒绝建号（拒绝启动）——务必先改成自己的强口令，登录后再改一次也可以。
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- HTTPS ------------------------------------------------------------------
# 面板自身不提供 TLS，TLS 由前面的 Nginx/Caddy 终结。开启后明文 HTTP 一律
# 308 到 https://<Host>（本机回环的健康检查除外），HTTPS 响应带 HSTS。
# 挂反代时务必让反代带上 X-Forwarded-Proto（见下面 FORWARDED_ALLOW_IPS）。
FORCE_HTTPS=false
# uvicorn 信任哪些来源传来的 X-Forwarded-Proto。默认只信本机反代；改成
# 0.0.0.0 等于让公网请求自称「我是 https」，从而绕过 FORCE_HTTPS。
# 同时决定「信任谁的 X-Forwarded-For」—— 限流按来源 IP 计数，只信反代的头。
FORWARDED_ALLOW_IPS=127.0.0.1

# --- 公网暴露加固 ------------------------------------------------------------
# 面板准入白名单（逗号分隔 IP / CIDR）：留空 = 任何来源都能访问；配置后
# 来源不在名单内的 HTTP / WebSocket 一律拒绝（/api/health 与本机回环除外）。
# 面板能管理整个 PVE，公网部署至少应收敛到办公网 / 跳板机 / 反代所在网段，
# 更推荐放在 VPN 或零信任网关之后。示例：
#   PANEL_ALLOW_CIDRS=203.0.113.0/24,10.8.0.0/24,192.168.1.10
# 注意：反代部署时 FORWARDED_ALLOW_IPS 必须填反代实际地址，否则这里看到的
# 是反代 IP，白名单会误拦全部用户。
PANEL_ALLOW_CIDRS=

# 首次从某个 IP 成功登录时，给所有管理员发站内消息 + 邮件（SMTP 未配置时
# 只发站内消息）。用于尽早发现密码泄露 / 账号被他人使用。
LOGIN_IP_ALERT=true

# 接口文档（/api/docs、/api/redoc、/api/openapi.json）默认关闭。
# 打开后不是匿名可读：这三个地址都要求「已登录 + settings.manage（管理员）」。
# 完整的 OpenAPI 定义等于一份全量接口地图（所有路径、字段约束、隐藏端点），
# 匿名可读会显著降低攻击者的侦察成本 —— 只在调试 / 内网排障时临时打开。
API_DOCS_ENABLED=false

# --- 登录防爆破 / 会话 / 两步验证 / 限流 ------------------------------------
# 登录人机验证（默认拖动滑块，可在「设置 → 登录验证」切换）可以被关掉，
# 光靠它挡不住脚本：这里按账号 + 来源 IP 双计数，
# 连续失败 N 次锁定一段时间，计数落 MySQL（重启不清零）。
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# access token 有效期（分钟）与 refresh token 有效期（天）。
# refresh token 放在 HttpOnly Cookie 里，前端在 401 时自动换新，所以 access
# 可以调短（例如 60）而不影响体验；改短后「踢下线」的生效也更快。
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14
# refresh cookie 是否只走 HTTPS（留空 = 跟随 FORCE_HTTPS）。
# COOKIE_SECURE=

# 强制开启两步验证的角色（逗号分隔）。留空 = 不强制，任何账号都可以在
# 「个人中心 → 两步验证」自行开启。
#
# **默认留空**：新装面板的第一件事是接入 Proxmox。此时若就把管理员锁在
# 「必须先去绑 2FA」上，连接测试、节点列表、仪表盘会整片 403，看起来像
# 装坏了 —— 引导应该先带人走完「能用」，再谈加固。
#
# 面板对外网开放时（尤其是直接暴露公网）不配 2FA 等于只用一个口令守 root，
# 那时请显式打开：
#   TOTP_REQUIRED_ROLES=admin
# TOTP_REQUIRED_ROLES=admin
# 认证器 App 里显示的名称，建议写成面板的公网域名
TOTP_ISSUER=Proxmox Panel
# 登录时是否允许勾选「信任设备」（同一台浏览器 7 天内免输动态码）。
# 要求每次登录都必须过第二因子的环境把它设成 false：登录页不再显示该勾选框，
# 后端即使收到 trust_device=true 也不签发。已签发的信任记录不受影响，
# 需要时由用户在「个人中心 → 退出所有设备」清掉，或等它们自然过期。
TOTP_TRUST_ENABLED=true

# 全局限流（按来源 IP，计数同样落 MySQL）。只作用于 /api/*，静态资源不受影响。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
# 登录 / 注册 / 找回密码 / 刷新令牌 / 2FA 单独一条更紧的线
RATE_LIMIT_AUTH_PER_MINUTE=30

# 敏感操作二次确认：删虚拟机、改连接凭据、增删账号、改邮件口令这类危险动作，
# 要求先用密码（开了两步验证再加动态码）重新确认身份。窗口内的重复操作
# 不必反复输入；窗口越长越方便，越短越安全。
STEP_UP_REQUIRED=true
STEP_UP_WINDOW_MINUTES=5

# --- 内网穿透（frp）目标白名单 ----------------------------------------------
# frpc 跑在面板后端所在的机器里，穿透规则里的 local_ip 就是它要连的目标。
# 普通用户默认只能指向**自己名下**的虚机 / 容器 IP；若还要放行其它内网地址，
# 在这里列出来（逗号分隔的 IP / CIDR）。留空 = 只允许自己名下的机器。
#   FRP_ALLOW_LOCAL_CIDRS=10.0.0.0/24,192.168.8.0/24
# 回环、未指定（0.0.0.0 / ::）、链路本地、组播、保留地址以及**面板自身地址**
# 始终拒绝，不受这份名单影响。
FRP_ALLOW_LOCAL_CIDRS=

# 是否禁止把「面板后端自身所在网段」当作目标。默认 true：面板通常与 PVE
# 管理网同网段，放开等于允许把面板 / PVE API 暴露到公网。若业务虚机与面板
# 同网段、且确实要穿透到该网段的其它服务，可改成 false（面板自身地址仍拒绝）。
FRP_BLOCK_PANEL_SUBNET=true

# 穿透规则的公网端口默认限制在 40000–50000，且不能与其它规则重复；22 / 80 /
# 443 / 7000 / 7001 / 8006 等关键端口始终不可占用。管理员可在「内网穿透」页面
# 直接把区间改成 frps 实际可用的那一段（NAT / 云安全组只放通了少数端口时尤其
# 需要），这里的值只作为初始值 / 兜底（见 app/frpguard.py）。
# FRP_REMOTE_PORT_MIN=40000
# FRP_REMOTE_PORT_MAX=50000
#
# 新增、修改、删除规则都需要二次确认（STEP_UP_REQUIRED 生效时）。

# --- Proxmox 连接（也可登录后在「设置」页面配置）-----------------------------
# 只填 IP 或域名，不要带 https:// 前缀
PVE_HOST=
PVE_PORT=8006
# 形如 panel@pve!panel
PVE_TOKEN_ID=
# Token 的 UUID，形如 1a2b3c4d-5e6f-7890-abcd-ef1234567890
PVE_TOKEN_SECRET=
# 出站访问 Proxmox 是否校验证书，**默认开启，不要关**。
# 出站访问 Proxmox 时是否校验证书。**默认 false**：PVE 出厂是自签证书
# （Cluster Manager CA、CN=pve.local、无 IP SAN），拿系统信任库校验必然失败，
# 新装配连接时会一直握手失败，看着像地址或令牌填错了。
#
# 想要校验就用「证书钉扎」：在连接配置里把该集群的证书 PEM 填进 ca_cert
# （只认那张证书，也不算「信任整个系统 CA」）；正规 CA 签发的环境把这里
# 改成 true 即可。关掉校验等于允许内网任何主机冒充 PVE、收走 API Token
# （审计项 FD-07），公网/多租户环境请务必钉扎或打开。
PVE_VERIFY_SSL=false
PVE_DEFAULT_NODE=

# 是否允许连接请求走环境变量里的 HTTP_PROXY / HTTPS_PROXY。
# 默认 false：Proxmox 一般在内网，若运行环境（容器、CI、企业网络）恰好设置了
# 代理变量，请求会被代理截走并返回难以理解的 502。
# 只有确实必须经代理访问集群时才改为 true，或把 Proxmox 地址加入 NO_PROXY。
PVE_TRUST_ENV=false

# --- 控制台（VNC / 串口）----------------------------------------------------
# Proxmox 不允许 API Token 访问 vncproxy / termproxy，这两类接口只接受
# 用户名密码换取的 ticket。若要使用浏览器内控制台，必须另外提供一个 PVE 账号。
# 建议用权限最小的专用账号（仅授予 PVEVMUser）。留空则控制台功能不可用，
# 其余功能不受影响。
PVE_CONSOLE_USER=
PVE_CONSOLE_PASSWORD=

# --- 其他 -------------------------------------------------------------------
# 允许的前端来源，逗号分隔（仅开发时跨域需要；生产同源部署可留空）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Proxmox API 请求超时（秒）
HTTP_TIMEOUT=30
# 任务状态轮询间隔（秒）
TASK_POLL_INTERVAL=2

# --- 监控历史落库 ------------------------------------------------------------
# 节点与虚拟机的 CPU / 内存 / 磁盘 / 网络指标按周期采样进 MySQL 的
# metrics_history 表，供「查任意历史区间 / 出周月报 / 容量预测」使用。
# PVE 自带的 rrddata 是主机侧滚动覆盖的，面板重启或主机重装都会丢。
METRICS_HISTORY_ENABLED=true
# 采样周期（秒）。60 秒 ≈ 每对象每天 1440 行。
METRICS_SAMPLE_INTERVAL=60
# 保留天数，每小时清理一次超期数据；填 0 或负数表示永久保留（表会一直涨）。
METRICS_RETENTION_DAYS=30

# --- 数据库（只支持 MySQL）---------------------------------------------------
# 先在 MySQL 里建好库与账号，表结构由面板启动时自动创建：
#   CREATE DATABASE zhangbeihai_panel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# 连接池上限
DB_POOL_SIZE=8
SSH_FORWARD_LOG_HOST=
SSH_FORWARD_PROXIES=
# 可选覆盖：转发机地址自动发现，一般不用填
SSH_FORWARD_ROUTES=
SSH_FORWARD_HAPROXY_CFG=
